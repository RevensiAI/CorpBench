{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "suite": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "const": "corpbench-work"
        },
        "version": {
          "type": "string",
          "const": "1.3"
        },
        "scoreProfile": {
          "type": "string",
          "const": "work"
        },
        "stage": {
          "type": "string",
          "const": "launch"
        },
        "repetitionsPerWorkflow": {
          "type": "number",
          "const": 1
        },
        "workflowCount": {
          "type": "number",
          "const": 100
        },
        "departmentCount": {
          "type": "number",
          "const": 5
        },
        "departments": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "finance",
              "marketing",
              "operations",
              "revops",
              "sales"
            ]
          },
          "additionalProperties": {
            "type": "number",
            "const": 20
          },
          "required": [
            "finance",
            "marketing",
            "operations",
            "revops",
            "sales"
          ]
        }
      },
      "required": [
        "id",
        "version",
        "scoreProfile",
        "stage",
        "repetitionsPerWorkflow",
        "workflowCount",
        "departmentCount",
        "departments"
      ],
      "additionalProperties": false
    },
    "workflows": {
      "minItems": 100,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "department": {
            "type": "string",
            "enum": [
              "finance",
              "marketing",
              "operations",
              "revops",
              "sales"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^workflows\\/(finance|marketing|operations|revops|sales)\\/[a-z0-9-]+\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "version",
          "department",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "results": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "const": "../../../results/work/1.3/report.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "suite",
    "workflows",
    "results"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/RevensiAI/CorpBench/work-v1.3/schemas/work-manifest.schema.json"
}
