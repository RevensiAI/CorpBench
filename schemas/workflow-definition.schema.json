{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "sourceSchemaVersion": {
      "anyOf": [
        {
          "type": "number",
          "const": 6
        },
        {
          "type": "number",
          "const": 7
        }
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "department": {
      "type": "string",
      "enum": [
        "marketing",
        "sales",
        "revops",
        "operations",
        "finance"
      ]
    },
    "systems": {
      "minItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxSteps": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxDurationMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxToolRetries": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "maxSteps",
        "maxTokens",
        "maxDurationMs",
        "maxToolRetries"
      ],
      "additionalProperties": false
    },
    "tools": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "outputSchema": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "name",
          "description",
          "parameters",
          "outputSchema"
        ],
        "additionalProperties": false
      }
    },
    "grader": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "type": "string",
          "const": "deterministic"
        },
        "mode": {
          "type": "string",
          "enum": [
            "exact-trace",
            "state-and-controls"
          ]
        }
      },
      "required": [
        "id",
        "version",
        "type"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "history": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "introducedAt": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "change": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "version",
          "introducedAt",
          "change"
        ],
        "additionalProperties": false
      }
    },
    "retireWhen": {
      "type": "string",
      "minLength": 1
    },
    "fixtures": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "availability": {
            "type": "string",
            "const": "withheld"
          }
        },
        "required": [
          "id",
          "version",
          "availability"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "sourceSchemaVersion",
    "id",
    "version",
    "department",
    "systems",
    "objective",
    "limits",
    "tools",
    "grader",
    "capabilities",
    "history",
    "retireWhen",
    "fixtures"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/RevensiAI/CorpBench/work-v1.3/schemas/workflow-definition.schema.json"
}
